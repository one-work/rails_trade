<% if item.persisted? %>
  <div id="cart_item_big_<%= item.cart_identity %>" data-controller="modify" data-modify-submit-value="true" data-modify-step-value="1" class="flex">
    <%= form_with theme: nil, url: { controller: item_con, action: 'update', id: item.id }, method: :patch, data: { controller: 'input' } do |f| %>
      <%= f.hidden_field :current_cart_id, value: cart.id %>
      <%=
        f.number_field(
          :number,
          value: item.number.to_human,
          step: 0.01,
          data: { action: 'change->input#form focus->input#blank', modify_target: 'input' },
          class: 'input background-light text-centered',
          style: 'width: 60px; height: 100%; font-size: x-large'
        )
      %>
      <%= hidden_field_tag 'replace[][partial]', 'cart_item_big' %>
    <% end %>
    <div class="has-column-centered xx ml-1">
      <% if item.number > 1 %>
        <button data-action="modify#minus" class="button is-small is-light is-danger" style="width: 60px">
          <%= svg_tag 'minus' %>
        </button>
      <% else %>
        <%=
          button_to(
            { controller: item_con, action: 'destroy', id: item.id },
            method: :delete,
            params: { current_cart_id: cart.id, 'replace[][partial]': 'cart_item_big' },
            class: 'button is-small is-light is-danger',
            style: 'width: 60px'
          ) do
        %>
          <%= svg_tag 'xmark' %>
        <% end %>
      <% end %>
      <button data-action="modify#plus" class="button is-danger" style="width: 60px">
        <%= svg_tag 'plus' %>
      </button>
    </div>
  </div>
<% else %>
  <%= form_with theme: nil, model: item, scope: '', url: { controller: item_con, action: 'create' }, id: "cart_item_big_#{item.cart_identity}", class: 'button_to' do |f| %>
    <%= f.hidden_field :current_cart_id, value: @cart.id if @cart %>
    <% f.object.valid_columns.each do |name, _| %>
      <%= f.hidden_field name, id: nil %>
    <% end %>
    <button type="submit" class="button is-small is-danger" name="replace[][partial]" value="cart_item_big">
      <%= svg_tag 'cart-plus' %>
      <span><%= t("#{item_con.tr('/', '.')}.create.title") %></span>
    </button>
  <% end %>
<% end %>
