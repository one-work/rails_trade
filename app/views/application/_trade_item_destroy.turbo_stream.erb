<% if referer_controller.end_with?('carts') %>
  <%= turbo_stream.replace 'cart_nav', partial: 'cart_footer', locals: { cart: @item.current_cart, cart_con: controller_path.sub('items', 'carts') } %>
<% else %>
  <%=
    turbo_stream.replace(
      'cart_nav',
      partial: 'cart_nav',
      locals: {
        cart: @item.current_cart,
        cart_con: controller_path.sub('items', 'carts'),
        order_con: controller_path.sub('items', 'orders')
      }
    )
  %>
<% end %>

<% params[:replace].each do |id, replace| %>
  <%=
    turbo_stream.replace(
      id,
      partial: replace['partial'],
      layout: replace['layout'],
      locals: {
        model: @item.good,
        item: @item,
        cart: @item.current_cart,
        item_con: controller_path,
        order_con: controller_path.sub('items', 'orders'),
        renew: params[:replace],
        renew_options: params.fetch(:renew_options, {}).permit!.to_h.to_options,
        refer_options: params.fetch(:refer_options, {}).permit!.to_h.to_options,
        extra_options: params.fetch(:renew_options, {}).fetch(replace['partial'], {}).permit!.to_h.to_options
      }
    )
  %>
<% end %>

<%= turbo_stream.remove "#{params[:remove]}_#{@item.cart_identity}" if params[:remove] %>
