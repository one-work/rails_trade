<div id="item_<%= model.id %>" class="<%= model.status_expired? ? 'media as-boxed background-light' : 'media as-boxed' %>">
  <%=
    form_with(
      theme: nil,
      model: model,
      url: { controller: 'items', action: 'toggle', id: model.id },
      data: { controller: 'input' },
      class: 'media-left'
    ) do |f|
  %>
    <%= f.hidden_field :current_cart_id, value: @cart.id %>
    <%= f.checkbox :status, { checked: model.status_checked?, data: { action: 'change->input#form' }, class: 'checkbox', id: nil }, model.id %>
  <% end %>
  <% if model.good.logo.attached? %>
    <div class="media-left">
      <%= image_tag model.good.logo.variant(resize_to_limit: [64, 64]), class: 'image is-64x64' %>
    </div>
  <% end %>
  <div class="media-content">
    <%= yield %>
  </div>
</div>
