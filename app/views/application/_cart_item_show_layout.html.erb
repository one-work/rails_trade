<tr id="cart_item_show_<%= item.cart_identity %>">
  <td>
    <%= form_with theme: nil, model: item, url: { controller: item_con, action: 'toggle', id: item.id }, method: :patch, data: { controller: 'input' } do |f| %>
      <%= f.hidden_field :current_cart_id, value: cart.id %>
      <%= f.checkbox :status, { checked: item.status_checked?, data: { action: 'click->input#form' }, id: nil }, id: item.id %>
    <% end %>
  </td>
  <td>
    <p><%= item.good_name %></p>
    <% if item.good.respond_to?(:parts) %>
      <ul class="media-info text-grey">
      <% item.good.production_parts.includes(:part, :component).each do |production_part| %>
        <li>
          <span><%= production_part.part.title_short %></span>
          <% if production_part.component.multiple %>
            <span>x</span>
            <span><%= production_part.number %></span>
          <% end %>
        </li>
      <% end %>
      </ul>
    <% end %>
  </td>
  <td><%= item.single_price.to_money.format.html_safe %></td>
  <td>
    <%= yield %>
  </td>
  <td><%= item.amount.to_money.format.html_safe %></td>
</tr>
