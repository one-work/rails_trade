<% if item.persisted? %>
  <div
    id="<%= item.cart_identity %>"
    data-controller="modify"
    data-modify-submit-value="true"
    class="has-inline-centered"
  >
    <%= button_to({ controller: item_con, action: 'destroy', id: item.id }, method: :delete, params: { current_cart_id: cart.id }, class: 'mr-1') do %>
      <%= svg_tag 'circle-xmark', class: 'icon' %>
    <% end %>
    <button data-action="modify#minus" class="button_to mr-1"<%= 'disabled' if item.number <= 1 %>>
      <%= svg_tag 'circle-minus', class: 'icon' %>
    </button>
    <%= form_with(theme: nil, scope: '', url: { controller: item_con, action: 'update', id: item.id }, method: :patch, data: { controller: 'input' }) do |f| %>
      <%= f.hidden_field :current_cart_id, value: cart.id %>
      <%= f.text_field :number, value: item.number.to_human, data: { action: 'change->input#form', modify_target: 'input' }, class: 'background-light text-centered', style: 'width: 3em' %>
    <% end %>
    <button data-action="modify#plus" class="button_to ml-1">
      <%= svg_tag 'circle-plus', class: 'icon' %>
    </button>
  </div>
<% else %>
  <%=
    form_with(
      theme: nil,
      model: item,
      scope: '',
      url: { controller: item_con, action: 'create' },
      id: item.cart_identity,
      class: 'button_to'
    ) do |f|
  %>
    <%= f.hidden_field :current_cart_id, value: cart.id %>
    <%= f.hidden_field :good_type %>
    <%= f.hidden_field :purchase_id %>
    <%= f.hidden_field :good_id %>
    <%= f.hidden_field :provide_id %>
    <%= button_tag type: 'submit', class: 'button is-rounded is-primary', disabled: !item.purchase do %>
      <%= svg_tag 'circle-plus', class: 'icon' %>
      <span><%= t('factory.in.items.create.title') %></span>
    <% end %>
  <% end %>
<% end %>
