<%= render layout: 'show_table_layout' do %>
  <%=
    render(
      partial: 'cart_item_show',
      layout: 'cart_item_show_layout',
      collection: @items,
      as: :item,
      locals: { cart: @cart, item_con: "trade/#{params[:namespace]}/items" }
    )
  %>
  <%= render partial: 'cart_promote', layout: 'cart_promote_tr', collection: @cart.cart_promotes, as: :model %>
<% end %>
