<%= render partial: 'order', locals: { model: @order } %>

<% if @order.address %>
<div class="card as-transparent">
  <div class="card-header">
    <p class="size-7 text-grey has-border-left-primary">收货地址</p>
  </div>
  <div class="card-content p-0">
    <%= render partial: 'address', locals: { model: @order.address } %>
  </div>
</div>
<% end %>

<% if @order.from_address %>
<div class="card as-transparent">
  <div class="card-header">
    <p class="size-7 text-grey has-border-left-primary">发货地址</p>
  </div>
  <div class="card-content p-0">
    <%= render partial: 'from_address', locals: { model: @order.from_address } %>
  </div>
</div>
<% end %>

<% if @order.packages.present? %>
  <%= render partial: 'packages', locals: { model: @order } %>
<% elsif @order.address %>
  <%= render partial: 'package_buttons', locals: { model: @order } %>
<% end %>

<div class="card as-transparent">
  <div class="card-header">
    <p class="size-7 text-grey has-border-left-primary">详情</p>
  </div>
  <div class="card-content p-0">
    <%= render 'show_table_form' %>
    <%= render partial: 'items', locals: { model: @order } %>
  </div>
</div>

<% if @order.cart_promotes.present? %>
<div class="card as-transparent">
  <div class="card-header">
    <strong class="size-7 text-grey has-border-left-primary">服务/促销</strong>
  </div>
  <div class="card-content p-0">
    <%= render partial: 'cart_promote', collection: @order.cart_promotes, as: :cart_promote %>
  </div>
</div>
<% end %>

<% if @order.payment_orders.present? %>
<div class="card as-transparent">
  <div class="card-header">
    <strong class="size-7 text-grey has-border-left-primary">支付</strong>
  </div>
  <div class="card-content p-0">
    <%= render partial: 'payment_order', collection: @order.payment_orders, as: :model %>
  </div>
</div>
<% end %>
