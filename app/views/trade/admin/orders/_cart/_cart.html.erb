<dl class="as-show as-boxed">
  <% if cart.contact.present? %>
    <div>
      <dt><%= Trade::Cart.human_attribute_name(:contact_id) %></dt>
      <dd><%= cart.contact.title %></dd>
    </div>
  <% end %>
  <% if cart.client.present? %>
    <div>
      <dt><%= Trade::Cart.human_attribute_name(:client_id) %></dt>
      <dd><%= cart.client.name %></dd>
    </div>
  <% end %>
  <div>
    <dt><%= Trade::Cart.human_attribute_name(:original_amount) %></dt>
    <dd><%= cart.original_amount.to_money.format.html_safe %></dd>
  </div>
  <div>
    <dt><%= Trade::Cart.human_attribute_name(:overall_additional_amount) %></dt>
    <dd><%= cart.overall_additional_amount.to_money.format.html_safe %></dd>
  </div>
  <div>
    <dt><%= Trade::Cart.human_attribute_name(:overall_reduced_amount) %></dt>
    <dd><%= cart.overall_reduced_amount.to_money.format.html_safe %></dd>
  </div>
  <div>
    <dt><%= Trade::Cart.human_attribute_name(:advance_amount) %></dt>
    <dd><%= cart.advance_amount.to_money.format.html_safe %></dd>
  </div>
  <div class="pl-4">
    <dt><strong><%= Trade::Cart.human_attribute_name(:amount) %></strong></dt>
    <dd><%= cart.amount.to_money.format.html_safe %></dd>
  </div>
</dl>
