<%= render 'top_bar_left' do %>
  <div class="bar-title"><%= @order.uuid %></div>
  <% if @order.desk %>
    <button
      data-controller="history"
      data-history-url-value="<%= url_for(controller: 'space/admin/desks', action: 'all', only_path: false) %>"
      data-action="history#direct"
      class="right"
    >
      <%= svg_tag 'grid-dividers', class: 'icon is-small text-link' %>
    </button>
  <% else %>
    <button
      data-controller="history"
      data-history-url-value="<%= url_for(controller: '/me/home', only_path: false) %>"
      data-action="history#direct"
      class="right"
    >
      <%= svg_tag 'user', class: 'icon is-small text-link' %>
    </button>
  <% end %>
<% end %>
