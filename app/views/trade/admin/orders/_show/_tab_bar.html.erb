<div class="buttons are-small as-bottom">
  <%=
    button_to(
      { controller: 'print/admin/home', action: 'inner' },
      params: { gid: @order.to_gid.to_s, aim: @order.print_aim },
      id: 'print-button',
      data: { controller: 'print-pos' },
      class: 'button is-rounded is-primary'
    ) do
  %>
    <%= svg_tag 'print' %>
    <span><%= t('print.admin.home.inner.title') %></span>
  <% end %>
  <% if @order.can_pay? %>
    <%= button_to({ controller: 'trade/admin/orders', action: 'adjust_edit', id: @order.id }, class: 'button is-rounded is-primary') do %>
      <%= svg_tag 'pen-clip' %>
      <span><%= t('.adjust_edit.title') %></span>
    <% end %>
    <%= button_to({ controller: 'trade/admin/payments', action: 'order_new', order_id: @order.id }, class: 'button is-rounded is-primary') do %>
      <%= svg_tag 'receipt' %>
      <span><%= t('trade.admin.payments.order_new.title') %></span>
    <% end %>
  <% end %>
  <%= link_to({ controller: 'trade/admin/orders', action: 'purchase', id: @order.id }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'cart-shopping' %>
    <span><%= t('.purchase.title') %></span>
  <% end %>
  <%= button_to({ action: 'update', id: @order.id }, method: :patch, params: { 'order[state]': 'produced' }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'box-check' %>
    <span>制作完成</span>
  <% end if ['init'].include?(@order.state) %>
</div>
