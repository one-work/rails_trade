<%= link_to({ controller: 'orders', action: 'show', id: model.id }, class: 'has-block-left px-2 mb-2') do %>
  <time data-controller="time"><%= model.created_at.to_fs(:iso8601) %></time>
  <% if model.agent %>
    <div class="tags has-addons mb-0">
      <span class="tag text-grey">下单人</span>
      <span class="tag is-warning"><%= model.agent.name %></span>
    </div>
  <% end %>
  <span class="tag"><%= model.payment_status_i18n %></span>
<% end %>
