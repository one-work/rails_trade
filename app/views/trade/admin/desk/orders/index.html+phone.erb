<%= render 'desk_bar' %>

<% @orders.each do |order| %>
  <div class="mb-3">
    <%= render partial: 'order_item', locals: { model: order } %>
    <%= render layout: 'index_list', locals: { order: order } do %>
      <%= render partial: 'index_item', layout: 'index_item_actions', collection: order.items, as: :model %>
    <% end %>
  </div>
<% end %>

<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary">详情</span>
  </div>
  <dl class="card-content as-show">
    <div>
      <dt><%= Trade::Order.human_attribute_name(:unreceived_amount) %></dt>
      <dd><%= @desk.counters['unreceived_amount'].to_money.format.html_safe %></dd>
    </div>
  </dl>
</div>

<%= paginate @orders %>
