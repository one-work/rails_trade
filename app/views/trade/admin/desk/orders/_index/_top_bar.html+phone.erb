<div class="as-bar">
  <button
    id="history-button"
    data-controller="history"
    data-history-url-value="<%= url_for(controller: 'space/admin/desks', action: 'all') %>"
    data-action="history#back"
    class="left"
  >
    <%= svg_tag 'angle-left', kind: 'regular', class: 'icon is-small text-link' %>
  </button>
  <div>
    <p class="text-weight-bold text-primary"><%= @desk.name %></p>
    <p class="size-7 text-grey"><%= @desk.room.name %></p>
  </div>
  <i class="right"></i>
</div>
