<div class="has-block-space-between px-2 mb-2">
  <%= link_to({ controller: 'orders', action: 'show', id: model.id }, class: 'has-block-left') do %>
    <time data-controller="time" data-format="HH:mm" class="text-weight-bold"><%= model.created_at.to_fs(:iso8601) %></time>
    <% if model.agent %>
      <div class="tags has-addons mb-0">
        <span class="tag is-info">下单人</span>
        <span class="tag is-link"><%= model.agent.name %></span>
      </div>
    <% end %>
    <span class="tag"><%= model.payment_status_i18n %></span>
  <% end %>
  <%=
    button_to(
      { controller: 'print/admin/home', action: 'inner' },
      params: { gid: model.to_gid.to_s, aim: 'receipt' },
      id: 'print-button',
      data: { controller: 'print-pos' }
    ) do
  %>
    <%= svg_tag 'print', class: 'icon is-small text-link' %>
  <% end %>
</div>
