<div class="columns m-0">
  <div class="column">
    <table class="table is-fullwidth as-boxed">
      <thead>
        <%= render 'index_thead' %>
      </thead>
      <tbody>
        <%=
          render(
            partial: 'cart_item_show',
            layout: 'cart_item_show_layout',
            collection: @items,
            as: :item,
            locals: {
              cart: @cart,
              item_con: 'trade/agent/items'
            }
          )
        %>
        <%= render partial: 'cart_promote', layout: 'cart_promote_tr', collection: @cart.cart_promotes, as: :model %>
      </tbody>
      <%= render 'cart_footer' %>
    </table>
  </div>
  <div class="column is-one-quarter">
    <%= button_to({ controller: 'crm/admin/contacts', action: 'new' }, class: 'button is-rounded is-fullwidth is-primary') do %>
      <span><%= t('crm.admin.contacts.new.title') %></span>
    <% end %>
    <%=
      button_to(
        { controller: 'ship/agent/cart/addresses', action: 'new', cart_id: @cart.id },
        class: 'button is-rounded is-fullwidth is-primary'
      ) do
    %>
      <span><%= t('ship.agent.cart.addresses.new.title') %></span>
    <% end %>
  </div>
</div>

<div class="has-block-centered px-3">
<% if @cart.can_order? %>
  <%= link_to({ controller: 'orders', action: 'cart', current_cart_id: @cart.id }, class: 'button is-medium is-primary') do %>
    <span class="mr-1">结算</span>
    <%= svg_tag 'angle-right' %>
  <% end %>
<% else %>
  <button class="button is-primary" disabled>
    <span class="mr-1">结算</span>
    <%= svg_tag 'angle-right' %>
  </button>
<% end %>
</div>