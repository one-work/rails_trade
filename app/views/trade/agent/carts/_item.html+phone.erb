<%= render layout: 'good_layout_with_right', locals: { model: model } do %>
  <div class="media-content">
    <div>
      <strong><%= model.good_name %></strong>
      <% if model.dispatch %>
        <span class="tag"><%= model.dispatch_i18n %></span>
      <% end %>
    </div>
    <% if model.good.respond_to?(:parts) %>
      <ul class="media-info">
      <% model.good.production_parts.includes(:part).each do |production_part| %>
        <li>
          <span><%= production_part.part.title_short %></span>
          <span>x</span>
          <span><%= production_part.number %></span>
        </li>
      <% end %>
      </ul>
    <% end %>
    <div class="flex flex-direction-column">
      <% if model.vip_code.present? %>
        <div class="tags has-addons is-price control mb-0">
          <div class="tag is-danger">
            <%= svg_tag 'badge-check' %>
            <span><%= model.vip_code %></span>
          </div>
          <span class="tag"><%= model.single_price.to_money.format.html_safe %></span>
        </div>
        <span class="text-through"><%= model.good.price.to_money.format.html_safe %></span>
      <% else %>
        <span><%= model.single_price.to_money.format.html_safe %></span>
      <% end %>
    </div>
  </div>
  <div class="media-right as-x">
    <%=
      render(
        partial: 'cart_item_big_cart',
        locals: {
          item: model,
          cart: @cart,
          item_con: controller_path.sub('carts', 'items'),
          removes: ["item_#{model.id}"]
        }
      )
    %>
  </div>
<% end %>
