<% if @order.items.pluck(:aim).all?('rent') %>
  <%= turbo_stream.visit url: url_for(action: 'payment_frozen', id: @order.id), action: 'replace' %>
<% elsif @order.items.pluck(:dispatch).all?('dine') %>
  <%= turbo_stream.visit url: url_for(action: 'show', id: @order.id), action: 'replace' %>
<% else %>
  <%= turbo_stream.visit url: url_for(action: 'payment_types', id: @order.id), action: 'replace' %>
<% end %>
