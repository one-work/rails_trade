<div class="buttons are-small as-bottom">
  <button
    data-controller="history"
    data-history-url-value="<%= url_for(controller: 'factory/productions', only_path: false) %>"
    data-action="history#direct"
    class="button is-rounded is-primary flex-grow-1"
  >
    <span>继续点单</span>
  </button>
  <%= button_to({ action: 'payment_types', id: @order.id }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'credit-card' %>
    <span>支付</span>
  <% end if @order.aim_use? && @order.can_pay? %>
  <%= link_to({ action: 'payment_frozen', id: @order.id }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'credit-card' %>
    <span>支付</span>
  <% end if @order.aim_rent? && @order.can_pay? %>
  <%= button_to({ action: 'actions', id: @order.id }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'ellipsis' %>
    <span><%= t('.actions.title') %></span>
  <% end %>
</div>
