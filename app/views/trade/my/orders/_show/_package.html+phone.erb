<dl class="as-show">
  <div>
    <dt><%= Ship::Package.human_attribute_name(:id) %></dt>
    <dd data-controller="clipboard">
      <span data-clipboard-target="source"><%= package.id %></span>
      <span class="tag"><%= package.state_i18n %></span>
      <span data-action="click->clipboard#copy" class="tag is-badge is-danger">复制</span>
      <div data-clipboard-target="toast" class="tag is-badge is-success display-none">
        <%= svg_tag 'check' %>
      </div>
    </dd>
  </div>
  <div>
    <dt><%= Ship::Package.human_attribute_name(:expected_on) %></dt>
    <dd class="weui-form-preview__value"><%= package.expected_on %></dd>
  </div>
  <div>
    <dt>包含物品：</dt>
    <dd class="weui-form-preview__value">
    <% package.packageds.includes(:item).each do |packaged| %>
      <span><%= packaged.item.good_name %></span>
    <% end %>
    </dd>
  </div>
  <div>
    <%=
      button_to(
        { controller: 'print/admin/home', action: 'inner' },
        params: { gid: package.to_gid.to_s, aim: 'label' },
        id: 'print-button',
        data: { controller: 'print-pos' },
        class: 'cell has-column-centered'
      ) do
    %>
      <%= svg_tag 'print' %>
      <span><%= t('print.admin.home.inner.title') %></span>
    <% end %>
    <%= link_to({ controller: 'packages', action: 'show', order_id: @order.id, id: package.id }, class: 'weui-form-preview__btn weui-form-preview__btn_primary', text: true) do %>
      <span>详情</span>
    <% end %>
  </div>
</dl>
