<div class="tabs is-centered is-sticky">
  <ul>
  <li class="<%= active_helper(holds_count: 0, active: 'is-active') %>">
    <%=
      link_to(
        '待交付',
        { 'holds_count': 0, **params.permit('extra/product_taxon_id') },
        data: { turbo_action: 'replace' }
      )
    %>
  </li>
  <li class="<%= active_helper('holds_count-gt': 0, active: 'is-active') %>">
  <%=
    link_to(
      '已交付',
      { 'holds_count-gt': 0, **params.permit('extra/product_taxon_id') },
      data: { turbo_action: 'replace' }
    )
  %>
  </li>
  </ul>
</div>
