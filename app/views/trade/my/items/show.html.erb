<div class="card as-transparent">
  <div class="card-header">
    <div class="is-several">
      <%= image_tag @item.good.logo.variant(resize_to_limit: [64, 64]), class: 'image is-64x64' if @item.good.logo.attached? %>
      <span><%= @item.good_name %></span>
    </div>
  </div>
  <div class="card-content">
    <%= render partial: 'item', locals: { model: @item } %>
  </div>
</div>

<%= render partial: 'hold', collection: @item.holds, as: :model %>
