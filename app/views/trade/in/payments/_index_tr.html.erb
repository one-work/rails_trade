<%=
  tr_tag(
    model,
    {
      action: url_for(action: 'destroy', id: model.id),
      method: :delete,
      title: t('.destroy.title'),
      icon: 'trash',
      confirm: t('.destroy.confirm'),
      position: 0,
      enable: model.is_a?(Trade::HandPayment)
    },
    {
      action: url_for(controller: 'refunds', action: 'new', payment_id: model.id),
      title: t('.refunds.new.title'),
      icon: 'thumbs-down'
    },
    {
      action: url_for(action: 'print', id: model.id),
      title: t('.print.title'),
      icon: 'print'
    },
    icons: ['show', 'edit']
  ) { yield }
%>
